{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noEmitOnError": true,
    "outDir": "../checks/reference-build",
    "rootDir": ".",
    "declaration": false,
    "skipLibCheck": false
  },
  "files": ["core-contracts.ts"]
}
